{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicability_target",
    "applicability_functions",
    "evidence"
  ],
  "properties": {
    "applicability_target": {
      "type": "string",
      "enum": [
        "clause_or_requirement",
        "method_or_technique",
        "process_or_activity",
        "object_or_component",
        "other",
        "none"
      ]
    },
    "applicability_functions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "scope_definition",
          "applicability_condition",
          "inclusion",
          "exclusion",
          "exception"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "function",
          "text"
        ],
        "properties": {
          "function": {
            "type": "string",
            "enum": [
              "scope_definition",
              "applicability_condition",
              "inclusion",
              "exclusion",
              "exception"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applicability_target": {
            "enum": [
              "method_or_technique",
              "process_or_activity",
              "object_or_component",
              "other",
              "none"
            ]
          }
        },
        "required": ["applicability_target"]
      },
      "then": {
        "properties": {
          "applicability_functions": {"maxItems": 0},
          "evidence": {"maxItems": 0}
        }
      }
    }
  ]
}
