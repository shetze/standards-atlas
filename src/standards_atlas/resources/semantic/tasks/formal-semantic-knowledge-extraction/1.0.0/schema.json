{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities", "relations"],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class_iri", "label", "confidence", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "class_iri": {"type": "string", "pattern": "^http://lunetix\\.org/standards-atlas#"},
          "label": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "predicate", "object_id", "confidence", "evidence"],
        "properties": {
          "subject_id": {"type": "string"},
          "predicate": {"type": "string", "pattern": "^http://lunetix\\.org/standards-atlas#"},
          "object_id": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
