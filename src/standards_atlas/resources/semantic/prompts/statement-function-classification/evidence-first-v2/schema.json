    "primary_function": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "requirement",
        "recommendation",
        "condemnation",
        "warning",
        "permission",
        "prohibition",
        "definition",
        "description",
        "explanation",
        "rationale",
        "example",
        "note",
        "conformance_statement",
        "objective",
        "prerequisite",
        "assumption",
        null
      ]
    },
    "primary_process_function": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "objective",
        "prerequisite",
        "input",
        "activity",
        "decision",
        "branch",
        "sequence",
        "output",
        "completion_criterion",
        "option",
        "assumption",
        null
      ]
    },
    "primary_applicability_function": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "applicability_condition",
        "inclusion",
        "exclusion",
        "exception",
        null
      ]
    },
    "primary_responsibility_function": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "responsibility_assignment",
        "responsibility_exclusion",
        "role_condition",
        null
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
