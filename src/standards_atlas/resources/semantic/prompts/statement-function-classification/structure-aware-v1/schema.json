{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statement_functions",
    "primary_function",
    "confidence",
    "rationale"
  ],
  "properties": {
    "statement_functions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "requirement",
          "recommendation",
          "permission",
          "prohibition",
          "definition",
          "description",
          "explanation",
          "rationale",
          "example",
          "note",
          "conformance_statement"
        ]
      }
    },
    "primary_function": {
      "enum": [
        "requirement",
        "recommendation",
        "permission",
        "prohibition",
        "definition",
        "description",
        "explanation",
        "rationale",
        "example",
        "note",
        "conformance_statement",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
