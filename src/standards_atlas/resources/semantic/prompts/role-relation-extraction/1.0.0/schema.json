{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role_relations"
  ],
  "properties": {
    "role_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor",
          "relation_class",
          "target"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "relation_class": {
            "type": "string",
            "minLength": 1,
            "description": "Open semantic relation class; prefer the documented core vocabulary when it fits."
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
