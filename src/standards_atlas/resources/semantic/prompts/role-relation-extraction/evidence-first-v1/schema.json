{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role_relations",
    "confidence",
    "rationale"
  ],
  "properties": {
    "role_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "relation",
          "target",
          "evidence",
          "confidence"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "responsible_for",
              "performs",
              "approves",
              "verifies",
              "validates",
              "consulted_for",
              "informed_about",
              "independent_of",
              "excluded_from",
              "assigned_to",
              "assumes_role",
              "participates_in"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
