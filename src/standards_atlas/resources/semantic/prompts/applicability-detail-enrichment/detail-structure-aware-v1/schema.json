{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicability_statement_confirmed",
    "applicability_functions",
    "evidence"
  ],
  "properties": {
    "applicability_statement_confirmed": {
      "type": "boolean"
    },
    "applicability_functions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "scope_definition",
          "applicability_condition",
          "inclusion",
          "exclusion",
          "exception"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "function",
          "text"
        ],
        "properties": {
          "function": {
            "type": "string",
            "enum": [
              "scope_definition",
              "applicability_condition",
              "inclusion",
              "exclusion",
              "exception"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
