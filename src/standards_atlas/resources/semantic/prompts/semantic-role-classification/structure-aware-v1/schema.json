{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "semantic_roles",
    "primary_role",
    "confidence",
    "rationale"
  ],
  "properties": {
    "semantic_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "foreword",
          "introduction",
          "scope",
          "normative_references",
          "terms_and_definitions",
          "abbreviations",
          "objectives",
          "requirements",
          "recommendations",
          "inputs",
          "outputs",
          "work_products",
          "verification",
          "validation",
          "assessment",
          "table",
          "figure",
          "note",
          "example",
          "annex",
          "bibliography",
          "compliance",
          "conformance"
        ]
      }
    },
    "primary_role": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "foreword",
            "introduction",
            "scope",
            "normative_references",
            "terms_and_definitions",
            "abbreviations",
            "objectives",
            "requirements",
            "recommendations",
            "inputs",
            "outputs",
            "work_products",
            "verification",
            "validation",
            "assessment",
            "table",
            "figure",
            "note",
            "example",
            "annex",
            "bibliography",
            "compliance",
            "conformance"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
